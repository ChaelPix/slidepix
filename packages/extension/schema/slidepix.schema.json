      },
      "required": [
        "enabled",
        "color",
        "fontSize"
      ],
      "additionalProperties": false
    },
    "layouts": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "background": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "slides": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "default": "Untitled slide",
            "type": "string"
          },
          "layout": {
            "type": "string"
          },
          "background": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "default": "",
            "type": "string"
          },
          "hidden": {
            "default": false,
            "type": "boolean"
          },
          "hidePageNumber": {
            "default": false,
            "type": "boolean"
          },
          "transition": {
            "default": {
              "type": "none",
              "durationMs": 500,
              "easing": "ease-in-out"
            },
            "type": "object",
            "properties": {
              "type": {
                "default": "none",
                "type": "string",
                "enum": [
                  "none",
                  "fade",
                  "slide-left",
                  "slide-right",
                  "slide-up",
                  "slide-down",
                  "morph"
                ]
              },
              "durationMs": {
                "default": 500,
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "easing": {
                "default": "ease-in-out",
                "type": "string"
              }
            },
            "required": [
              "type",
              "durationMs",
              "easing"
            ],
            "additionalProperties": false
          },
          "timeline": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "targetElementId": {
                  "type": "string",
                  "minLength": 1
                },
                "phase": {
                  "default": "entrance",
                  "type": "string",
                  "enum": [
                    "entrance",
                    "exit"
                  ]
                },
                "effect": {
                  "default": "fade",
                  "type": "string",
                  "enum": [
                    "appear",
                    "fade",
                    "fly"
                  ]
                },
                "trigger": {
                  "default": "onClick",
                  "type": "string",
                  "enum": [
                    "onClick",
                    "withPrevious",
                    "afterPrevious"
                  ]
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "left",
                    "right",
                    "up",
                    "down"
                  ]
                },
                "delayMs": {
                  "default": 0,
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 60000
                },
                "durationMs": {
                  "default": 500,
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 60000
                },
                "easing": {
                  "default": "ease-out",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "targetElementId",
                "phase",
                "effect",
                "trigger",
                "delayMs",
                "durationMs",
                "easing"
              ],
              "additionalProperties": false
            }
          },
          "elements": {
            "default": [],
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "morphKey": {
                      "type": "string",
                      "minLength": 1
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "width": {
                      "type": "number",
                      "minimum": 0
                    },
                    "height": {
                      "type": "number",
                      "minimum": 0
                    },
                    "rotation": {
                      "default": 0,
                      "type": "number"
                    },
                    "opacity": {
                      "default": 1,
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "z": {
                      "default": 0,
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "locked": {
                      "default": false,
                      "type": "boolean"
                    },
                    "hidden": {
                      "default": false,
