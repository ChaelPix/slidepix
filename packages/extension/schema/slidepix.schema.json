                        "fontWeight": {
                          "default": 400,
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "number"
                            }
                          ]
                        },
                        "color": {
                          "default": "#f8fafc",
                          "type": "string",
                          "minLength": 1
                        },
                        "textAlign": {
                          "default": "left",
                          "type": "string",
                          "enum": [
                            "left",
                            "center",
                            "right"
                          ]
                        },
                        "verticalAlign": {
                          "default": "top",
