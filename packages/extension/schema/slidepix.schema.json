{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": {
          "default": "Untitled deck",
          "type": "string"
        },
        "author": {
          "default": "",
          "type": "string"
        },
        "description": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "title",
        "author",
        "description"
      ],
      "additionalProperties": false
    },
    "size": {
      "type": "object",
      "properties": {
        "width": {
          "default": 1920,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "default": 1080,
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "properties": {
        "background": {
          "default": "#0f172a",
          "type": "string",
          "minLength": 1
        },
        "foreground": {
          "default": "#f8fafc",
          "type": "string",
          "minLength": 1
        },
        "accent": {
          "default": "#38bdf8",
          "type": "string",
          "minLength": 1
        },
        "fontFamily": {
          "default": "Inter, sans-serif",
          "type": "string"
        }
      },
      "required": [
        "background",
        "foreground",
        "accent",
        "fontFamily"
      ],
      "additionalProperties": false
    },
    "pageNumbers": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "color": {
          "default": "#94a3b8",
          "type": "string",
          "minLength": 1
        },
        "fontSize": {
          "default": 24,
          "type": "number",
          "minimum": 0
