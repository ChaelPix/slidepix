                          "enum": [
                            "top",
                            "middle",
                            "bottom"
                          ]
                        },
                        "lineHeight": {
                          "default": 1.2,
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "padding": {
                          "default": 8,
                          "type": "number",
                          "minimum": 0
