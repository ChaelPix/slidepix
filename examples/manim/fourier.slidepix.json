          "name": "title",
          "type": "text",
          "markdown": "## Une courbe, écrite comme des notes",
          "style": {
            "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
            "fontSize": 48,
